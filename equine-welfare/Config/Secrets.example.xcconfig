//
//  Secrets.example.xcconfig
//  equine-welfare
//
//  Copy this file to Secrets.xcconfig and fill in your values.
//

// Convex deployment URL (get from Convex dashboard)
// Note: Use $() to escape // in URLs — xcconfig treats // as a comment delimiter
CONVEX_URL = https:/$()/your-deployment.convex.cloud

// Clerk publishable key (get from Clerk dashboard)
CLERK_PUBLISHABLE_KEY = pk_test_...

// PocketBase server URL (local dev; use your Mac's LAN IP for a physical iPad)
// Note: Use $() to escape // in URLs — xcconfig treats // as a comment delimiter
POCKETBASE_URL = http:/$()/localhost:8090
