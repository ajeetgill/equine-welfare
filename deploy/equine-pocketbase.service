# systemd unit for the equine-welfare PocketBase backend.
# Install: copy to /etc/systemd/system/, replace YOUR_DOMAIN below, then
#   systemctl daemon-reload && systemctl enable --now equine-pocketbase
#
# Passing a domain makes PocketBase bind :80/:443 and auto-provision a
# Let's Encrypt certificate — no reverse proxy needed. For a bare-IP LAN
# setup instead, change ExecStart to: /opt/equine/pocketbase serve --http=0.0.0.0:8090

[Unit]
Description=Equine Welfare PocketBase backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocketbase
Group=pocketbase
WorkingDirectory=/opt/equine
ExecStart=/opt/equine/pocketbase serve YOUR_DOMAIN
Restart=on-failure
RestartSec=5
# Allow binding :80/:443 as a non-root user
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
